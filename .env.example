# Settle environment. The app reads the process environment; it does not load
# this file. Copy the values you need into your shell, or into a gitignored .env
# that you export yourself.
#
# Credentials: use an IAM role or OIDC. Locally, set AWS_PROFILE. In CI, assume
# a role (GitHub Actions: aws-actions/configure-aws-credentials, role-to-assume).
# The AgentCore runtime already has its own role. Do not set AWS_ACCESS_KEY_ID
# or AWS_SECRET_ACCESS_KEY.

AWS_REGION=us-east-1
AWS_PROFILE=

# bedrock = Strands BedrockModel on the Converse API. offline = no AWS.
SETTLE_MODEL=bedrock

# Amazon Nova Pro (US inference profile) in us-east-1.
# Anthropic ids (anthropic.* and *.anthropic.*) are rejected.
SETTLE_MODEL_ID=us.amazon.nova-pro-v1:0
